{
  "rules": {
    "pump_system": {
      "status": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "control": {
        ".read": "auth != null",
        "mode": {
          ".write": "auth.uid === 'ZScmJXQg2tZSVDiZ1YxTUxN36xw1' || auth.uid === 'vQ4s0FyCmjMgoeltwcZR7WfckXZ2'"
        },
        "clear_error": {
          ".write": "auth != null"
        }
      },
      "config": {
        "device": {
          ".read": "auth != null",
          ".write": "auth.uid === 'ZScmJXQg2tZSVDiZ1YxTUxN36xw1' || auth.uid === 'vQ4s0FyCmjMgoeltwcZR7WfckXZ2'"
        },
        "notifications_by_user": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "notification_last_sent": {
          "$uid": {
            ".read": false,
            ".write": false
          }
        }
      }
    }
  }
}
