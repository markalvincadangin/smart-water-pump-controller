{
  "rules": {
    "pump_system": {
      ".read": "auth != null",
      "status": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
      },
      "control": {
        ".read": "auth != null",
        "mode": {
          ".write": "auth != null && (root.child('pump_system/config/admins').child(auth.uid).val() === true || auth.token.firebase.sign_in_provider === 'password')"
        },
        "manual_desired": {
          ".write": "auth != null && root.child('pump_system/config/admins').child(auth.uid).val() === true"
        },
        "emergency_stop": {
          ".write": "auth != null && (root.child('pump_system/config/admins').child(auth.uid).val() === true || (auth.token.firebase.sign_in_provider === 'password' && newData.val() === false))"
        },
        "reset_stop": {
          ".write": "auth != null && (root.child('pump_system/config/admins').child(auth.uid).val() === true || (auth.token.firebase.sign_in_provider === 'password' && newData.val() === false))"
        },
        "countdown_start": {
          ".write": "auth != null && (root.child('pump_system/config/admins').child(auth.uid).val() === true || (auth.token.firebase.sign_in_provider === 'password' && newData.val() === false))"
        },
        "clear_error": {
          ".write": "auth != null && (root.child('pump_system/config/admins').child(auth.uid).val() === true || (auth.token.firebase.sign_in_provider === 'password' && newData.val() === false))"
        },
        "reboot_request_id": {
          ".write": "auth != null && root.child('pump_system/config/admins').child(auth.uid).val() === true"
        },
        "countdown_add_min": {
          ".write": "auth != null && root.child('pump_system/config/admins').child(auth.uid).val() === true"
        },
        "manual_start": {
          ".write": "auth != null && root.child('pump_system/config/admins').child(auth.uid).val() === true"
        },
        "manual_stop": {
          ".write": "auth != null && root.child('pump_system/config/admins').child(auth.uid).val() === true"
        },
        "countdown_duration_min": {
          ".write": "auth != null && root.child('pump_system/config/admins').child(auth.uid).val() === true"
        },
        "countdown_add_time": {
          ".write": "auth != null && (root.child('pump_system/config/admins').child(auth.uid).val() === true || (auth.token.firebase.sign_in_provider === 'password' && newData.val() === false))"
        },
        "countdown_stop": {
          ".write": "auth != null && (root.child('pump_system/config/admins').child(auth.uid).val() === true || (auth.token.firebase.sign_in_provider === 'password' && newData.val() === false))"
        },
        "bypass_level_sensor": {
          ".write": "auth != null && root.child('pump_system/config/admins').child(auth.uid).val() === true"
        },
        "bypass_flow_sensor": {
          ".write": "auth != null && root.child('pump_system/config/admins').child(auth.uid).val() === true"
        }
      },
      "config": {
        "device": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('pump_system/config/admins').child(auth.uid).val() === true"
        },
        "notifications_by_user": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "notification_last_sent": {
          "$uid": {
            ".read": false,
            ".write": false
          }
        },
        "admins": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && root.child('pump_system/config/admins').child(auth.uid).val() === true"
          }
        }
      },
      "presence": {
        ".read": "auth != null",
        "$session": {
          ".write": "auth != null && (newData.child('uid').val() === auth.uid) && (newData.child('email').isString() || newData.child('email').val() === null) && newData.child('at').exists()",
          ".validate": "newData.hasChildren(['uid','at'])"
        }
      },
      "audit": {
        "events": {
          ".read": "auth != null",
          "$eventId": {
            ".write": "auth != null && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['action','uid','deviceId','at'])"
          }
        }
      },
      "logs": {
        "errors": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
        }
      }
    }
  }
}
