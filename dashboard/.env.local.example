# .env.local.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase — from Firebase Console → Project Settings → General → Your apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Push notifications (FCM) — Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Optional: Restrict dashboard access to specific Firebase UIDs
# Comma-separated list. Leave empty to allow any signed-in Google user (Firebase rules still enforce control writes).
# Find your UID: Firebase Console → Authentication → Users (after first Google sign-in)
NEXT_PUBLIC_AUTHORIZED_UIDS=

# Optional: Admin users (advanced settings + privileged controls like FORCE ON)
# Comma-separated list. If empty, defaults to the same as AUTHORIZED_UIDS behavior.
NEXT_PUBLIC_ADMIN_UIDS=
