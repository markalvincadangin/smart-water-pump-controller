# .env.local.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase — from Firebase Console → Project Settings → General → Your apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Push notifications (FCM) — Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Optional: Restrict dashboard access to specific Firebase UIDs
# Comma-separated list. Leave empty to allow any signed-in Google user (Firebase rules still enforce control writes).
# Find your UID: Firebase Console → Authentication → Users (after first Google sign-in)
NEXT_PUBLIC_AUTHORIZED_UIDS=

# (Legacy/optional) Admin users via env — currently unused.
# Admins are now controlled via the Realtime Database at:
#   pump_system/config/admins/{uid} = true
# This variable is kept only for backwards compatibility and is ignored by new code.
# NEXT_PUBLIC_ADMIN_UIDS=

# Optional: overrides the tank label shown in the dashboard header.
# Useful if your installation uses a different tank size or name.
# Example: NEXT_PUBLIC_TANK_LABEL="Deep Well Pump · 1000L Tank"
# If omitted, the default label is "Deep Well Pump · 660L Tank".
# NEXT_PUBLIC_TANK_LABEL=