{
  "ci": {
    "collect": {
      "url": [
        "/",
        "/login"
      ],
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready in|started server on|Ready on|ready - started server on",
      "startServerReadyTimeout": 60000,
      "settings": {
        "chromeFlags": [
          "--disable-gpu",
          "--no-first-run",
          "--no-default-browser-check"
        ]
      },
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:pwa": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.6
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}

