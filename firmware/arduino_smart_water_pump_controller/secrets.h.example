// ─────────────────────────────────────────────────────────────────────────────
// Copy this file to secrets.h and fill in your credentials.
// NEVER commit secrets.h — it is gitignored.
// ─────────────────────────────────────────────────────────────────────────────

#ifndef SECRETS_H
#define SECRETS_H

// --- WiFi Credentials ---
#define WIFI_SSID       "your_wifi_ssid"
#define WIFI_PASSWORD   "your_wifi_password"

// --- Firebase Project Credentials ---
#define API_KEY         "your_firebase_api_key"
#define DATABASE_URL    "https://your-project-default-rtdb.firebaseio.com"

// --- Firebase Email/Password Auth ---
// Create this user in Firebase Console → Authentication → Users → Add user
#define FIREBASE_EMAIL    "your_email@example.com"
#define FIREBASE_PASSWORD "your_firebase_password"

#endif
