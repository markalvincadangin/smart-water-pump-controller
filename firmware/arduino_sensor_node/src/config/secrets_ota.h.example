#pragma once

// Copy this file to secrets_ota.h in the same folder and fill in your network.
// secrets_ota.h is gitignored — never commit real credentials.

#define OTA_WIFI_SSID       "your_wifi_ssid"
#define OTA_WIFI_PASSWORD   "your_wifi_password"

// mDNS name: http://<hostname>.local (ArduinoOTA / PlatformIO espota)
#ifndef OTA_HOSTNAME
  #define OTA_HOSTNAME      "swpc-sensor-node"
#endif

// Optional: require a password for OTA uploads (recommended on shared networks).
// Leave empty string to disable (convenient on a trusted LAN only).
#define OTA_UPLOAD_PASSWORD ""
