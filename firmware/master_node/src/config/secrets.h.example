// secrets.h.example
// ─────────────────────────────────────────────────────────────────────────────
// Copy this file to secrets.h and fill in your credentials.
// NEVER commit secrets.h — it is gitignored.
// ─────────────────────────────────────────────────────────────────────────────

#ifndef SECRETS_H
#define SECRETS_H

// --- Firebase Project Credentials ---
#define API_KEY         "your_firebase_api_key"
#define DATABASE_URL    "https://your-project-default-rtdb.firebaseio.com"

// --- Per-device cloud bootstrap ---
// Each device receives a distinct secret. Store its backend counterpart only in
// Google Cloud Secret Manager; never place a fleet-wide secret in firmware.
#define DEVICE_BOOTSTRAP_SECRET "replace_with_this_devices_unique_secret"
#define DEVICE_BOOTSTRAP_URL    "https://asia-southeast1-your-project.cloudfunctions.net/bootstrapDevice"
// Paste the public PEM trust root for the deployed endpoint as a C++ raw string.
// This is public certificate material, not a secret. Do not use setInsecure().
static constexpr const char DEVICE_BOOTSTRAP_ROOT_CA[] = R"EOF(
-----BEGIN CERTIFICATE-----
replace_with_the_google_trust_root_pem
-----END CERTIFICATE-----
)EOF";

// --- Local development OTA ---
// Use a strong, developer-local password. Never commit the real value.
#define SMARTFLOW_OTA_PASSWORD "replace_with_a_strong_local_password"

#endif
