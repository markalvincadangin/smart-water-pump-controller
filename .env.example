# --- SmartFlow Local Development Environment ---
# Copy this file to .env and replace the values with your local network settings.
# Do NOT commit your actual .env file.

# The IP address and port of your Android testing device (for Wireless ADB)
POCO_IP=192.168.1.X:XXXXX

# Absolute path to your Android SDK platform-tools adb.exe
ADB_PATH=C:\Users\YourUsername\AppData\Local\Android\Sdk\platform-tools\adb.exe

# The local Wi-Fi IP address of your ESP32 (for OTA and Telnet)
ESP32_IP=192.168.1.X

# A strong, developer-local password for OTA flashing (must match secrets.h)
SMARTFLOW_OTA_PASSWORD=your_local_ota_password
